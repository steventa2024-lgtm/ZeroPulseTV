<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the TV through cloud backup or device-to-device transfer: in particular the JARVIS
     pairing (zp_jarvis.xml: PC address, certificate pin, Keystore-encrypted device token). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
