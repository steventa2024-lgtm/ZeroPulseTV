<?xml version="1.0" encoding="utf-8"?>
<!-- Existing HOME activity and package ID retain the owner's default launcher and settings. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.calmhome.launcher"
    android:versionCode="3002"
    android:versionName="3.0.0-beta.2">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Target 34 requires this normal permission for JobScheduler network constraints. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Persistent user-initiated APK transfers and the system installation approval dialog. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: lets the launcher see the apps it lists -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.tcl.tv" />
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="ZeroPulse TV"
        android:icon="@drawable/zp_icon"
        android:banner="@drawable/zp_banner"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".assistant.AssistantActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density|fontScale|locale|layoutDirection" />
        <service android:name=".downloads.DownloadJob" android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".downloads.BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <receiver android:name=".downloads.InstallReceiver" android:exported="false" />
        <activity android:name=".downloads.ApprovalActivity" android:exported="false"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
